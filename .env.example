# QRIS pusat Jasa-in (server-only, JANGAN pakai prefix NEXT_PUBLIC_).
# Sengaja dikosongkan dulu sampai Asra merilis QRIS pusat; selama kosong,
# pesanan memakai QRIS seller sebagai fallback sementara.
JASA_IN_QRIS_STATIC_PAYLOAD=
